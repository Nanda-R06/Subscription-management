# Brightloop Billing Environment Configuration
PORT=5000
NODE_ENV=development

# Database configuration
# Set DATABASE_URL for PostgreSQL, e.g.: postgresql://postgres:postgres@localhost:5432/brightloop_billing
# When DATABASE_URL is not set or DB_MODE=sqlite, automatic zero-config SQLite mode is used
DB_MODE=auto
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_billing
SQLITE_DB_PATH=./data/brightloop.sqlite

# JWT & Cryptographic Secrets
JWT_ACCESS_SECRET=brightloop_access_super_secret_key_production_2026_!@#
JWT_REFRESH_SECRET=brightloop_refresh_super_secret_key_production_2026_!@#
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for password reset links and CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20
